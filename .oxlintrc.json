{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "eslint",
    "oxc",
    "unicorn"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": [
        "scripts/**",
        "*.config.js",
        "*.cjs",
        "**/*.test.js"
      ],
      "env": {
        "node": true,
        "browser": true
      }
    },
    {
      "files": [
        "supabase/functions/**"
      ],
      "globals": {
        "Deno": "readonly"
      }
    }
  ]
}
