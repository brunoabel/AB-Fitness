{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ba-fitness.vercel.app" }],
      "destination": "https://www.abfitness.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "u" },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|discordbot|linkedinbot|slackbot|slack-imgproxy|pinterest|applebot|vkshare|embedly|skypeuripreview).*"
        }
      ],
      "destination": "/api/og-athlete"
    },
    {
      "source": "/((?!api/|assets/|favicon|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,HEAD" },
        { "key": "Access-Control-Allow-Headers", "value": "X-Requested-With, content-type, Authorization" }
      ]
    }
  ]
}
